# ==========================================
# FLOODPRINT AI — ENVIRONMENT CONFIGURATION TEMPLATE
# (Do NOT commit actual secret values to source control)
# ==========================================

# Backend Server Port (Default: 3001)
PORT=3001

# Google Gemini API Key (Backend service only — NEVER expose to browser)
GEMINI_API_KEY=

# Cloudinary Storage Configuration
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Client Configuration (Web App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API URL (Leave blank in local development for Vite proxy; set in production)
VITE_API_BASE_URL=
